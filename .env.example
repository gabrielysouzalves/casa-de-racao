# Copie este arquivo para .env. Nunca envie o .env para o repositório.
# MySQL local (substitua o usuário e configure a senha da sua instalação).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=casa_de_racao

# Gere um segredo aleatório de pelo menos 32 caracteres para proteger as senhas.
# Não reutilize o segredo de outro computador: ele precisa permanecer estável
# para cada instalação com usuários cadastrados.
AUTH_PEPPER=

# Preenchido pelo script scripts/set-initial-admin-password.mjs.
# Não armazene a senha em texto puro aqui.
INITIAL_ADMIN_HASH=
